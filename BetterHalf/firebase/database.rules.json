{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "tokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "invites": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() ? newData.child('uid').val() === auth.uid : (data.child('uid').val() === auth.uid || (!data.child('claimed').exists() && newData.child('claimed/uid').val() === auth.uid)))"
      }
    },
    "couples": {
      "$cid": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && (data.child('members').child(auth.uid).exists() || (!data.exists() && newData.child('members').child(auth.uid).exists()))",
        "inbox": { "$uid": { ".indexOn": ["ts"] } }
      }
    }
  }
}
